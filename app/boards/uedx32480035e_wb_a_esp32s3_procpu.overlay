 *
 * VIEWE UEDX32480035E-WB-A: the light bulb is the on-board WS2812 RGB LED
 * (rgb_led, alias led-strip). Matter runs over Wi-Fi.
 */

/ {
	aliases {
		bulb-strip = &rgb_led;
	};
};

&sdhc0 {
	status = "disabled";
};
