 *
 * VIEWE UEDX32480035E-WB-A: the light bulb is the on-board WS2812 RGB LED
 * (rgb_led, alias led-strip). Matter runs over Wi-Fi.
 */

/ {
	chosen {
		/* Matter state (fabrics, attributes) is kept in the settings */
		zephyr,settings-partition = &storage_partition;
	};

	aliases {
		bulb-strip = &rgb_led;
	};
};

/* Not used by the light: free their pins and RAM. */
&esp32_bt_hci {
	status = "disabled";
};

&sdhc0 {
	status = "disabled";
};
